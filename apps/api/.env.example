# Copia este archivo como .env para cambiar la configuración. Todo es opcional.

# Servidor
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Sesión: sin SESSION_SECRET se genera uno por arranque y las sesiones no sobreviven un reinicio.
# SESSION_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
SESSION_HOURS=8
# Cookie solo por HTTPS: activar al desplegar detrás de TLS.
COOKIE_SECURE=false

# Usuario de demostración (se crea al arrancar si no existe)
DEMO_EMAIL=demo@bia.energy
DEMO_PASSWORD=energia2026

# LLM local para redactar las explicaciones (ADR 0006)
#   auto   → usa Ollama si responde y tiene el modelo; si no, plantillas (por defecto)
#   ollama → intenta siempre Ollama (si falla, plantillas)
#   none   → solo plantillas
LLM_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_MS=60000

# Rutas (por defecto relativas a apps/api)
# DATABASE_FILE=.data/aiem.db
# DATA_DIR=../../data
